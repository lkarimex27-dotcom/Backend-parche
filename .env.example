NODE_ENV=development
PORT=3000

# Cadena de conexión de Neon (Dashboard > Connect). Debe incluir sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Orígenes permitidos por CORS, separados por coma (tu frontend / admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT: genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=1d

# Primer administrador (lo crea `npm run db:seed`). Cambia la clave después del primer login.
ADMIN_EMAIL=admin@minifood.com
ADMIN_PASSWORD=cambia_esta_clave_123
ADMIN_NOMBRE=Administrador
